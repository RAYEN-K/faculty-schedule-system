@Injectable()
export class RequestsService {
  constructor(private readonly prisma: PrismaService) {}

  async create(userId: string, dto: CreateRequestDto) {
    if (dto.type === RequestType.MODIFICATION) {
      if (!dto.scheduleId) {
        throw new BadRequestException('scheduleId is required for a MODIFICATION request type');
      }
      const schedule = await this.prisma.schedule.findUnique({ where: { id: dto.scheduleId } });
      if (!schedule || schedule.userId !== userId) {
        throw new BadRequestException('This slot does not exist or does not belong to you');
      }
    }

    return this.prisma.modificationRequest.create({
      data: { ...dto, userId },
    });
  }

  async findMyRequests(userId: string) {
    return this.prisma.modificationRequest.findMany({
      where: { userId },
      orderBy: { createdAt: 'desc' },
    });
  }

  async findDepartmentRequests(departmentId: string) {
    return this.prisma.modificationRequest.findMany({
      where: { user: { departmentId } },
      include: { user: { select: { id: true, fullName: true, email: true } } },
      orderBy: { createdAt: 'desc' },
    });
  }

  async updateStatus(id: string, dto: UpdateStatusDto, reviewerId?: string) {
    const { status, compensationScheduleId, compensationWeekStartDate } = dto;

    const request = await this.prisma.modificationRequest.findUnique({ where: { id } });
    if (!request) {
      throw new NotFoundException(`Request #${id} not found`);
    }

    if (status !== RequestStatus.APPROVED) {
      return this.prisma.modificationRequest.update({ where: { id }, data: { status } });
    }

    const updatedRequest = await this.prisma.modificationRequest.update({
      where: { id },
      data: {
        status,
        reviewedById: reviewerId,
        reviewedAt: new Date(),
      },
    });

    if (request.type === RequestType.ADDITIONAL && request.proposedDate) {
      const date = new Date(request.proposedDate);
      await this.prisma.schedule.create({
        data: {
          userId: request.userId,
          dayOfWeek: date.getDay(),
          startTime: date.toISOString().substring(11, 16) || '08:30',
          endTime: '10:00',
        },
      });
    }

    if (request.type === RequestType.MODIFICATION && request.scheduleId && request.proposedDate) {
      const newDate = new Date(request.proposedDate);
      const originalSlot = await this.prisma.schedule.findUnique({ where: { id: request.scheduleId } });
      await this.prisma.scheduleException.create({
        data: {
          scheduleId: request.scheduleId,
          weekStartDate: startOfWeek(newDate),
          newDayOfWeek: newDate.getDay(),
          newStartTime: originalSlot?.startTime ?? '08:30',
          newEndTime: originalSlot?.endTime ?? '10:00',
          requestId: request.id,
        },
      });
    }

    if (request.type === RequestType.COMPENSATION && request.proposedDate) {
      const date = new Date(request.proposedDate);
      await this.prisma.schedule.create({
        data: {
          userId: request.userId,
          dayOfWeek: date.getDay(),
          startTime: date.toISOString().substring(11, 16) || '08:30',
          endTime: '10:00',
        },
      });

      if (compensationScheduleId && compensationWeekStartDate) {
        await this.prisma.scheduleException.create({
          data: {
            scheduleId: compensationScheduleId,
            weekStartDate: startOfWeek(new Date(compensationWeekStartDate)),
            newDayOfWeek: -1,
            newStartTime: '',
            newEndTime: '',
            isSkipped: true,
            requestId: request.id,
          },
        });
      }
    }

    return updatedRequest;
  }

  async findAll(page = 1, pageSize = 20) {
    return this.prisma.modificationRequest.findMany({
      skip: (page - 1) * pageSize,
      take: pageSize,
      include: {
        user: { select: { id: true, fullName: true, email: true, departmentId: true } },
      },
    });
  }
}
